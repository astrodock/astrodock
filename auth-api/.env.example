PORT=3100
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
ADMIN_JWT_SECRET=change-me-to-a-random-string

# GitHub integration (fine-grained PAT with contents:read + webhooks:read/write)
GITHUB_PAT=github_pat_...
GITHUB_OWNER=your-github-username-or-org

# Provisioning & deploys (production only — not needed for local dev)
BASE_DOMAIN=seniorverse.dev
CADDY_FILE=/etc/caddy/Caddyfile
STATIC_DIR=/var/www
APPS_DIR=/opt/apps
REPOS_DIR=/opt/repos

# Only needed for seeding
ADMIN_EMAIL=admin@seniorverse.dev
ADMIN_PASSWORD=change-me
