# CLI credentials for THIS app — copy to .env.astrodock and fill in.
# .env.astrodock is gitignored, and the CLI refuses to run if git tracks it.
# Create the token in the admin UI (Access keys), scoped as tightly as possible,
# one token per app. Environment variables with the same names win over this file.
ASTRODOCK_URL=https://admin.example.com
ASTRODOCK_TOKEN=tk_...
