# The platform INJECTS the TOOLSTEAD_* variables at deploy — you do NOT set them here.
# This file is only for running the app locally, outside the platform.
#
# Reserved (read these; never hardcode). Which appear depends on your app.json modes:
#   TOOLSTEAD_PORT            the port your server MUST bind          (always)
#   TOOLSTEAD_APP_URL         your public URL                          (always)
#   TOOLSTEAD_AUTH_URL        control-plane /verify base               (auth.mode=platform)
#   TOOLSTEAD_APP_ID          = your slug                              (auth.mode=platform)
#   TOOLSTEAD_APP_SECRET      app secret for /verify                   (auth.mode=platform)
#   TOOLSTEAD_APP_JWT_SECRET  sign your own sessions with this         (auth.mode=platform)
#   TOOLSTEAD_DATABASE_URL    connection string                        (database.mode != none)
#   TOOLSTEAD_STORAGE_*       S3 endpoint/region/bucket/keys/prefix    (storage.mode != none)
#
# App-declared (from app.json env[]) — set real values via `toolstead set-secret` or the admin UI:
WELCOME_MESSAGE=Welcome to your Toolstead app (local)

# ── Local dev only ──
TOOLSTEAD_PORT=3000
# Point at a running control plane to test real login locally (optional):
TOOLSTEAD_AUTH_URL=http://localhost:3100
TOOLSTEAD_APP_ID=starter
TOOLSTEAD_APP_SECRET=
TOOLSTEAD_APP_JWT_SECRET=local-dev-secret
