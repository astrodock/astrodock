# The platform INJECTS the ASTRODOCK_* variables at deploy — you do NOT set them here.
# This file is only for running the app locally, outside the platform.
#
# Reserved (read these; never hardcode). Which appear depends on your app.json modes:
#   ASTRODOCK_PORT            the port your server MUST bind          (always)
#   ASTRODOCK_APP_URL         your public URL                          (always)
#   ASTRODOCK_AUTHORIZE_URL   where to send the BROWSER to sign in     (auth.mode=platform)
#   ASTRODOCK_LOGOUT_URL      sign out of every app on the platform    (auth.mode=platform)
#   ASTRODOCK_AUTH_URL        INTERNAL base for the code exchange      (auth.mode=platform)
#   ASTRODOCK_APP_ID          = your slug                              (auth.mode=platform)
#   ASTRODOCK_APP_SECRET      app secret for /verify                   (auth.mode=platform)
#   ASTRODOCK_APP_JWT_SECRET  sign your own sessions with this         (auth.mode=platform)
#   ASTRODOCK_DATABASE_URL    connection string                        (database.mode != none)
#   ASTRODOCK_STORAGE_*       S3 endpoint/region/bucket/keys/prefix    (storage.mode != none)
#
# App-declared (from app.json env[]) — set real values via `astrodock set-secret` or the admin UI:
WELCOME_MESSAGE=Welcome to your Astrodock app (local)

# ── Local dev only ──
ASTRODOCK_PORT=3000
# Point at a running control plane to test real login locally (optional):
ASTRODOCK_AUTH_URL=http://localhost:3100
ASTRODOCK_AUTHORIZE_URL=http://localhost:3100/authorize
ASTRODOCK_APP_ID=starter
ASTRODOCK_APP_SECRET=
ASTRODOCK_APP_JWT_SECRET=local-dev-secret
