{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrodock.ai/app.schema.json",
  "title": "app.json",
  "description": "Astrodock app manifest. Declared configuration and environment-variable NAMES only \u2014 never secret values.",
  "type": "object",
  "required": [
    "schemaVersion",
    "slug",
    "name",
    "subdomain",
    "source",
    "runtime",
    "auth",
    "database",
    "storage"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "maxLength": 40
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "subdomain": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "maxLength": 40
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "branch": {
          "type": "string",
          "default": "main",
          "pattern": "^[A-Za-z0-9._/-]+$",
          "maxLength": 200
        },
        "repoPath": {
          "type": "string",
          "default": "",
          "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._/-]*$",
          "maxLength": 200
        },
        "githubRepo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$",
          "description": "owner/repo \u2014 optional; can also be set via the CLI/admin UI."
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "node",
            "docker"
          ]
        },
        "buildCommand": {
          "type": "string",
          "maxLength": 500
        },
        "dockerfile": {
          "type": "string",
          "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._/-]+$",
          "maxLength": 200
        },
        "spa": {
          "type": "boolean",
          "default": true,
          "description": "Whether the frontend is a single-page app. True (the default) sends unknown paths to index.html so a client router can handle them. Set false for a static site: unknown paths then get a real 404 from 404.html instead of the homepage."
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "platform",
            "public"
          ]
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "internal",
            "external",
            "none"
          ]
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "internal",
            "external",
            "none"
          ]
        }
      }
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^(?!ASTRODOCK_)[A-Z][A-Z0-9_]*$"
          },
          "secret": {
            "type": "boolean",
            "default": false
          },
          "required": {
            "type": "boolean",
            "default": false
          },
          "default": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "scripts": {
      "type": "object",
      "description": "Named shell commands the platform may run inside this app's directory, from Operations. The text lives in the repository so it is reviewed and committed; a caller chooses which name to run, never the command itself.",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9:-]{0,39}$"
      }
    },
    "feedback": {
      "type": "object",
      "description": "User feedback: where it comes in and what happens to it. Every field is optional; the platform's defaults are the opinionated ones.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether this app accepts feedback at all."
        },
        "widget": {
          "type": "boolean",
          "default": true,
          "description": "Serve the drop-in widget. Turn off to use the API directly with your own UI."
        },
        "anonymous": {
          "type": "boolean",
          "default": false,
          "description": "Accept feedback from someone the app has not vouched for. An email typed into the form is contact information, not identity."
        },
        "snapshot": {
          "type": "boolean",
          "default": false,
          "description": "Store a DOM snapshot with each report. Useful for layout bugs, and it captures whatever was on the user's screen."
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "bug",
            "idea",
            "question"
          ],
          "description": "What a person can file it as."
        },
        "ai_mode": {
          "enum": [
            "off",
            "draft",
            "auto"
          ],
          "default": "draft",
          "description": "off: no triage. draft: a model writes an internal note and a reply held for a human to send. auto: the reply is sent without review."
        },
        "webhook": {
          "type": "string",
          "format": "uri",
          "description": "HTTPS endpoint POSTed on every new submission, so your own process can take over. Never receives internal notes."
        }
      }
    }
  }
}
