# ─────────────────────────────────────────────────────────────────────────────
# Toolstead stack configuration. Copy to .env and fill in. `docker compose up -d`.
# .env is gitignored — never commit real secrets. All platform vars use TOOLSTEAD_.
# ─────────────────────────────────────────────────────────────────────────────

# ── Domain / routing ──
# The base domain all apps live under: <app-subdomain>.<base-domain>.
# For a real deploy, point a wildcard DNS record *.<base-domain> at this host.
TOOLSTEAD_BASE_DOMAIN=example.com
TOOLSTEAD_ADMIN_SUBDOMAIN=admin
# auto = Let's Encrypt (needs a public domain + DNS); internal = Caddy's own CA
# (LAN / no public DNS); off = plain HTTP (behind another proxy / quick local test)
TOOLSTEAD_TLS_MODE=auto
TOOLSTEAD_ACME_EMAIL=you@example.com

# ── Admin login + first-boot seed ──
# Generate a long random secret, e.g.  openssl rand -hex 32
TOOLSTEAD_ADMIN_JWT_SECRET=
TOOLSTEAD_ADMIN_EMAIL=admin@example.com
TOOLSTEAD_ADMIN_PASSWORD=

# Master key for encrypting stored secrets at rest (AES-256-GCM). STRONGLY recommended.
# If unset, secrets are stored in plaintext and the control plane warns at boot.
TOOLSTEAD_SECRET_KEY=

# ── Bundled Postgres ──
TOOLSTEAD_PG_USER=toolstead
TOOLSTEAD_PG_PASSWORD=
TOOLSTEAD_PG_DATABASE=toolstead

# ── Bundled object store (SeaweedFS S3) ──
# Apps in internal-storage mode receive these (shared key + per-app prefix in v1).
TOOLSTEAD_OBJECTSTORE_REGION=us-east-1
TOOLSTEAD_OBJECTSTORE_ACCESS_KEY=toolstead
TOOLSTEAD_OBJECTSTORE_SECRET_KEY=
TOOLSTEAD_OBJECTSTORE_BUCKET=toolstead

# ── GitHub (deploys) ──
# Fine-grained PAT with contents:read + repo webhooks read/write.
TOOLSTEAD_GITHUB_PAT=
TOOLSTEAD_GITHUB_OWNER=

# ── Email / alerts (optional — health-monitor down/recovery emails via Resend) ──
TOOLSTEAD_EMAIL_FROM=Toolstead <noreply@example.com>
TOOLSTEAD_ALERT_EMAIL=
TOOLSTEAD_RESEND_API_KEY=

# ── Feature flags ──
# The per-app terminal is arbitrary RCE by design — leave OFF unless you understand
# the threat model (SECURITY.md).
TOOLSTEAD_ENABLE_TERMINAL=false

# (Network-specific values — TOOLSTEAD_PG_HOST, object-store endpoint, Caddy admin,
#  docker network, runner paths — are set by docker-compose.yml and need not be here.)
