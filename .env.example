# ─────────────────────────────────────────────────────────────────────────────
# Astrodock stack configuration. Copy to .env and fill in. `docker compose up -d`.
# .env is gitignored — never commit real secrets. All platform vars use ASTRODOCK_.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ──
# production (default when unset) | development
# Set this to `development` when running the control plane on your host machine
# against the Vite dev server: outside production the CORS matcher accepts
# http://localhost:<any-port>. Leave it unset (or `production`) for a real deploy.
ASTRODOCK_ENV=production

# ── Domain / routing ──
# LEAVE BLANK to configure in the browser. With no base domain the stack boots into
# first-run setup: Caddy serves the dashboard over plain HTTP at http://<server-ip>,
# and the wizard collects the domain, shows you the exact DNS record to create,
# checks it, then switches on HTTPS. Setting it here just skips that step.
#
# The base domain all apps live under: <app-subdomain>.<base-domain>.
# For a real deploy, point a wildcard DNS record *.<base-domain> at this host.
ASTRODOCK_BASE_DOMAIN=
ASTRODOCK_ADMIN_SUBDOMAIN=admin
# auto = Let's Encrypt (needs a public domain + DNS); internal = Caddy's own CA
# (LAN / no public DNS); off = plain HTTP (behind another proxy / quick local test)
# Ignored until a base domain exists — setup mode is always plain HTTP.
ASTRODOCK_TLS_MODE=auto
ASTRODOCK_ACME_EMAIL=

# ── Admin login ──
# Generate a long random secret, e.g.  openssl rand -hex 32
ASTRODOCK_ADMIN_JWT_SECRET=
# LEAVE BLANK to create the administrator in the browser. On first boot with no
# admin, the control plane prints a one-time setup token to its logs
# (`docker compose logs api`); the wizard exchanges it for the account you choose.
# Filling these in seeds the admin directly and skips the claim step instead.
ASTRODOCK_ADMIN_EMAIL=
ASTRODOCK_ADMIN_PASSWORD=

# Choose the first-run setup token yourself instead of reading it from the logs.
# Set it in your cloud provider's user-data / cloud-init field and you can go
# straight to the browser without opening a shell on the server.
# Must be at least 16 characters with no whitespace, or it is ignored and a random
# one is generated. It stops working the moment the account is claimed — which is
# why this is safer than seeding ASTRODOCK_ADMIN_PASSWORD above, since anything
# in instance metadata is readable by whatever runs on the box.
ASTRODOCK_SETUP_TOKEN=

# Master key for encrypting stored secrets at rest (AES-256-GCM). STRONGLY recommended.
# If unset, secrets are stored in plaintext and the control plane warns at boot.
ASTRODOCK_SECRET_KEY=

# Shared secret the control plane uses to authenticate to the runner (internal network).
ASTRODOCK_RUNNER_TOKEN=

# ── Bundled Postgres ──
ASTRODOCK_PG_USER=astrodock
ASTRODOCK_PG_PASSWORD=

# ── Container registry (only for a PRIVATE image) ─────────────────────────────
# Astrodock's published image is public, so most installs leave these blank.
# They are needed if you run a private fork — and they must be here, not only in
# `docker login`, because updating from the dashboard runs the pull inside a
# container that does not share the host's Docker credentials.
ASTRODOCK_REGISTRY_USER=
ASTRODOCK_REGISTRY_TOKEN=
ASTRODOCK_PG_DATABASE=astrodock

# ── Bundled object store (SeaweedFS S3) ──
# Apps in internal-storage mode receive these (shared key + per-app prefix in v1).
ASTRODOCK_OBJECTSTORE_REGION=us-east-1
ASTRODOCK_OBJECTSTORE_ACCESS_KEY=astrodock
ASTRODOCK_OBJECTSTORE_SECRET_KEY=
ASTRODOCK_OBJECTSTORE_BUCKET=astrodock

# ── GitHub (deploys) ──
# Fine-grained PAT with contents:read + repo webhooks read/write.
ASTRODOCK_GITHUB_PAT=
ASTRODOCK_GITHUB_OWNER=

# ── Email / alerts (optional — health-monitor down/recovery emails via Resend) ──
ASTRODOCK_EMAIL_FROM=Astrodock <noreply@example.com>
ASTRODOCK_ALERT_EMAIL=
ASTRODOCK_RESEND_API_KEY=

# ── Pages (lightweight hosted documents / mini-sites at pages.<base-domain>) ──
# All optional — sensible defaults shown. The bucket is created automatically.
ASTRODOCK_PAGES_SUBDOMAIN=pages
ASTRODOCK_PAGES_BUCKET=astrodock-pages
# Max size of a page's saved-data JSON blob (per page, or per page+user).
ASTRODOCK_PAGE_DATA_MAX=1mb


# (Network-specific values — ASTRODOCK_PG_HOST, object-store endpoint, Caddy admin,
#  docker network, runner paths — are set by docker-compose.yml and need not be here.)
