# Toolstead control-plane configuration.
# All platform-managed config uses the reserved TOOLSTEAD_ prefix.
# Copy to .env for local dev; in the docker compose stack these come from the root .env.

PORT=3100
TOOLSTEAD_ENV=production

# ── Domain / routing ──
TOOLSTEAD_BASE_DOMAIN=localhost
TOOLSTEAD_ADMIN_SUBDOMAIN=admin
# auto = Let's Encrypt (real domain); internal = Caddy's own CA (LAN/dev); off = plain HTTP
TOOLSTEAD_TLS_MODE=internal
TOOLSTEAD_ACME_EMAIL=
# Optional: override the CORS allowed-origin regex (defaults to *.<base-domain> + localhost)
TOOLSTEAD_ALLOWED_ORIGIN_PATTERN=

# ── Admin auth + seed ──
TOOLSTEAD_ADMIN_JWT_SECRET=change-me-to-a-long-random-string
TOOLSTEAD_ADMIN_EMAIL=admin@example.com
TOOLSTEAD_ADMIN_PASSWORD=change-me
# Encrypts stored secrets at rest (AES-256-GCM). Unset = plaintext + a boot warning.
TOOLSTEAD_SECRET_KEY=change-me-to-a-long-random-string

# ── Bundled Postgres (control-plane store + internal app DBs) ──
TOOLSTEAD_PG_HOST=postgres
TOOLSTEAD_PG_PORT=5432
TOOLSTEAD_PG_USER=toolstead
TOOLSTEAD_PG_PASSWORD=change-me
TOOLSTEAD_PG_DATABASE=toolstead
# host:port apps use to reach the bundled DB (compose network address)
TOOLSTEAD_PG_APP_HOST=postgres
TOOLSTEAD_PG_APP_PORT=5432

# ── Bundled object store (SeaweedFS S3) ──
TOOLSTEAD_OBJECTSTORE_ENDPOINT=http://objectstore:8333
TOOLSTEAD_OBJECTSTORE_APP_ENDPOINT=http://objectstore:8333
TOOLSTEAD_OBJECTSTORE_REGION=us-east-1
TOOLSTEAD_OBJECTSTORE_ACCESS_KEY=change-me
TOOLSTEAD_OBJECTSTORE_SECRET_KEY=change-me
TOOLSTEAD_OBJECTSTORE_BUCKET=toolstead

# ── GitHub (deploys) ──
TOOLSTEAD_GITHUB_PAT=
TOOLSTEAD_GITHUB_OWNER=

# ── Runner paths (inside the runner container) ──
TOOLSTEAD_STATIC_DIR=/data/static
TOOLSTEAD_APPS_DIR=/data/apps
TOOLSTEAD_REPOS_DIR=/data/repos
TOOLSTEAD_CADDY_STATIC_DIR=/srv/static

# ── Caddy admin API + Docker network (sibling containers) ──
TOOLSTEAD_CADDY_ADMIN=http://caddy:2019
TOOLSTEAD_DOCKER_NETWORK=toolstead_default

# ── Internal /verify address apps call (compose network) ──
TOOLSTEAD_INTERNAL_AUTH_URL=http://api:3100

# ── Email / alerts (optional) ──
TOOLSTEAD_EMAIL_FROM=Toolstead <noreply@example.com>
TOOLSTEAD_ALERT_EMAIL=
TOOLSTEAD_RESEND_API_KEY=

# ── Feature flags ──
# Arbitrary RCE by design — keep OFF unless you understand the threat model (see SECURITY.md)
TOOLSTEAD_ENABLE_TERMINAL=false
