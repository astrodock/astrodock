# Astrodock control-plane configuration.
# All platform-managed config uses the reserved ASTRODOCK_ prefix.
# Copy to .env for local dev; in the docker compose stack these come from the root .env.

PORT=3100
ASTRODOCK_ENV=production

# ── Domain / routing ──
ASTRODOCK_BASE_DOMAIN=localhost
ASTRODOCK_ADMIN_SUBDOMAIN=admin
# auto = Let's Encrypt (real domain); internal = Caddy's own CA (LAN/dev); off = plain HTTP
ASTRODOCK_TLS_MODE=internal
ASTRODOCK_ACME_EMAIL=
# Optional: override the CORS allowed-origin regex (defaults to *.<base-domain> + localhost)
ASTRODOCK_ALLOWED_ORIGIN_PATTERN=

# ── Admin auth + seed ──
ASTRODOCK_ADMIN_JWT_SECRET=change-me-to-a-long-random-string
ASTRODOCK_ADMIN_EMAIL=admin@example.com
ASTRODOCK_ADMIN_PASSWORD=change-me
# Encrypts stored secrets at rest (AES-256-GCM). Unset = plaintext + a boot warning.
ASTRODOCK_SECRET_KEY=change-me-to-a-long-random-string

# ── Bundled Postgres (control-plane store + internal app DBs) ──
ASTRODOCK_PG_HOST=postgres
ASTRODOCK_PG_PORT=5432
ASTRODOCK_PG_USER=astrodock
ASTRODOCK_PG_PASSWORD=change-me
ASTRODOCK_PG_DATABASE=astrodock
# host:port apps use to reach the bundled DB (compose network address)
ASTRODOCK_PG_APP_HOST=postgres
ASTRODOCK_PG_APP_PORT=5432

# ── Bundled object store (SeaweedFS S3) ──
ASTRODOCK_OBJECTSTORE_ENDPOINT=http://objectstore:8333
ASTRODOCK_OBJECTSTORE_APP_ENDPOINT=http://objectstore:8333
ASTRODOCK_OBJECTSTORE_REGION=us-east-1
ASTRODOCK_OBJECTSTORE_ACCESS_KEY=change-me
ASTRODOCK_OBJECTSTORE_SECRET_KEY=change-me
ASTRODOCK_OBJECTSTORE_BUCKET=astrodock

# ── GitHub (deploys) ──
ASTRODOCK_GITHUB_PAT=
ASTRODOCK_GITHUB_OWNER=

# ── Runner paths (inside the runner container) ──
ASTRODOCK_STATIC_DIR=/data/static
ASTRODOCK_APPS_DIR=/data/apps
ASTRODOCK_REPOS_DIR=/data/repos
ASTRODOCK_CADDY_STATIC_DIR=/srv/static

# ── Caddy admin API + Docker network (sibling containers) ──
ASTRODOCK_CADDY_ADMIN=http://caddy:2019
ASTRODOCK_DOCKER_NETWORK=astrodock_default

# ── Internal /verify address apps call (compose network) ──
ASTRODOCK_INTERNAL_AUTH_URL=http://api:3100

# ── Email / alerts (optional) ──
ASTRODOCK_EMAIL_FROM=Astrodock <noreply@example.com>
ASTRODOCK_ALERT_EMAIL=
ASTRODOCK_RESEND_API_KEY=

