# SV Platform Setup Configuration
# Copy this to setup.conf and fill in your values before running deploy-platform.sh
# IMPORTANT: Wrap all values in single quotes to avoid issues with special characters

# Droplet
DROPLET_IP=''
SSH_KEY='~/.ssh/id_ed25519'

# MongoDB (managed cluster connection string)
MONGODB_URI='mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority'

# DO Spaces
SPACES_REGION='nyc3'
SPACES_BUCKET='sv-tools-data'
SPACES_KEY=''
SPACES_SECRET=''

# GitHub (fine-grained PAT: contents:read, webhooks:read+write)
GITHUB_PAT=''
GITHUB_OWNER=''

# Auth
ADMIN_EMAIL='admin@seniorverse.dev'
ADMIN_PASSWORD=''

# Domain
BASE_DOMAIN='seniorverse.dev'

# Generated automatically if left blank
ADMIN_JWT_SECRET=''
